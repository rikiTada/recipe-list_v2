{
  "name": "recipe-list_v2",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "generate": "dotenv -e .env.local -- npx prisma generate",
    "migrate": "dotenv -e .env.local --  bash prisma/migrate.sh",
    "setup": "bun migrate && bun generate",
    "studio": "npx prisma studio",
    "format": "prisma format",
    "d1:migrate": "wrangler d1 migrations apply recipe-list --local",
    "d1:seed": "wrangler d1 execute recipe-list --local --file=./prisma/dummy-data.sql",
    "d1:remote:migrate:": "wrangler d1 migrations apply recipe-list --remote",
    "d1:remote:seed": "wrangler d1 execute recipe-list --remote --file=./prisma/dummy-data.sql",
    "dev:script": "dotenv -e .env.local -- ts-node -r tsconfig-paths/register -P tsconfig.script.json --transpile-only",
    "rename": "bash rename.sh",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "@libsql/client": "^0.7.0",
    "@prisma/adapter-d1": "^5.16.2",
    "@prisma/client": "^5.16.1",
    "@radix-ui/react-checkbox": "^1.0.4",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-toast": "^1.1.5",
    "@tanstack/react-table": "^8.17.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "dotenv-cli": "^7.4.2",
    "drizzle-orm": "^0.31.4",
    "firebase": "^10.12.2",
    "hono": "^4.4.12",
    "lucide-react": "^0.383.0",
    "next": "14.2.3",
    "next-themes": "^0.3.0",
    "postgres": "^3.4.4",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.52.0",
    "sonner": "^1.4.41",
    "swr": "^2.2.5",
    "tailwind-merge": "^2.3.0",
    "tailwindcss-animate": "^1.0.7",
    "typescript-eslint": "^7.17.0",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^1.5.0",
    "@cloudflare/next-on-pages": "^1.11.3",
    "@cloudflare/workers-types": "^4.20240614.0",
    "@storybook/addon-essentials": "^8.1.10",
    "@storybook/addon-interactions": "^8.1.10",
    "@storybook/addon-links": "^8.1.10",
    "@storybook/addon-onboarding": "^8.1.10",
    "@storybook/blocks": "^8.1.10",
    "@storybook/nextjs": "^8.1.10",
    "@storybook/react": "^8.1.10",
    "@storybook/test": "^8.1.10",
    "@types/node": "^20.14.10",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^9.8.0",
    "eslint-config-next": "14.2.3",
    "eslint-plugin-unused-imports": "^4.0.1",
    "eslint-plugin-storybook": "^0.8.0",
    "postcss": "^8",
    "prisma": "^5.16.1",
    "storybook": "^8.1.10",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  }
}
